  "name": "roma-theme-v2",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/camisetasroma/roma-theme-v2#readme",
  "bugs": {
    "url": "https://github.com/camisetasroma/roma-theme-v2/issues"
