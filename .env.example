# Copie para .env (git-ignored).
#
# FTP da loja Nuvemshop (mesmas credenciais dos GitHub Secrets do workflow
# .github/workflows/ftp-deploy.yml). Hoje só existe a loja de dev (ADR-0012).
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=

# Alvo do Playwright (ADR-0015). Sem estes valores a suíte usa a loja de dev e
# os slugs padrão de tests/helpers.mjs; sobrescreva quando o catálogo mudar.
ROMA_STORE_URL=https://democamisetasromadev.lojavirtualnuvem.com.br
ROMA_PRODUCT_PATH=/produtos/camiseta-estonada-brita/
ROMA_CATEGORY_PATH=/camisetas/
